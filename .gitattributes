# Normalize to LF on commit, keep OS-native on checkout
* text=auto

# Lock specific file types as LF (server deployments are Linux)
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.css         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.sql         text eol=lf

# Binary files — never touch
*.png         binary
*.jpg         binary
*.ico         binary
*.svg         text eol=lf
