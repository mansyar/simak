{
  "name": "simak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:i18n && vite dev",
    "build": "pnpm generate:i18n && vite build && pnpm build:migrate && pnpm build:seed",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --format=esm --platform=node --outfile=.output/server/migrate.mjs --external:child_process",
    "build:seed": "esbuild src/db/seed.ts --bundle --format=esm --platform=node --outfile=.output/server/seed.mjs",
    "start": "vinxi start",
    "test": "vitest run --exclude tests/integration/** --exclude tests/unit/lib/parse-templates-xlsx.test.ts --exclude tests/unit/lib/parse-users-xlsx.test.ts --exclude tests/unit/lib/sample-generators.test.ts && vitest run --pool=threads tests/unit/lib/parse-templates-xlsx.test.ts tests/unit/lib/parse-users-xlsx.test.ts tests/unit/lib/sample-generators.test.ts",
    "test:unit": "vitest run --exclude tests/integration/** --exclude tests/unit/lib/parse-templates-xlsx.test.ts --exclude tests/unit/lib/parse-users-xlsx.test.ts --exclude tests/unit/lib/sample-generators.test.ts && vitest run --pool=threads tests/unit/lib/parse-templates-xlsx.test.ts tests/unit/lib/parse-users-xlsx.test.ts tests/unit/lib/sample-generators.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest --exclude tests/integration/** --exclude tests/unit/lib/parse-templates-xlsx.test.ts --exclude tests/unit/lib/parse-users-xlsx.test.ts --exclude tests/unit/lib/sample-generators.test.ts",
    "test:coverage": "vitest run --coverage --pool=threads --exclude tests/integration/**",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "oxlint .",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,css}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env --import=tsx src/db/seed.ts",
    "generate:i18n": "tsx scripts/generate-i18n-types.ts",
    "check:i18n": "node scripts/check-i18n-keys.js",
    "check:i18n:unused": "node scripts/check-i18n-keys.js --show-unused",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/s3-request-presigner": "^3.1052.0",
    "@base-ui/react": "^1.4.1",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.72.0",
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/react-start": "^1.114.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typesafe-i18n": "^5.26.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "0.31.10",
    "happy-dom": "^20.9.0",
    "jsdom": "^26.0.0",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vinxi": "^0.5.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-auth",
      "esbuild"
    ]
  }
}
