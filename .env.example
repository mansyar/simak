# Database
DATABASE_URL=postgresql://simak:simak_password@localhost:5432/simak
# MIGRATE_DATABASE_URL=postgresql://simak:simak_password@localhost:5432/simak

# File Storage (Cloudflare R2)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-access-key-id>
R2_SECRET_ACCESS_KEY=<your-secret-access-key>
R2_BUCKET_NAME=simak-uploads
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Email (Resend)
RESEND_API_KEY=<your-resend-api-key>
# EMAIL_FROM=SIMAK <noreply@simak.app>

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=<generate-a-random-secret>
BETTER_AUTH_URL=http://localhost:3000

# SuperAdmin Seed
SUPERADMIN_EMAIL=superadmin@simak.local
SUPERADMIN_PASSWORD=<generate-a-strong-password>

# Logging (optional — defaults to "info")
# LOG_LEVEL=info
